<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="uta-page d-flex align-items-center justify-content-center" style="height: 80vh;">
                            <div class="uta-card text-center p-5">
                                <i class="bi bi-shield-lock text-danger" style="font-size: 4rem;"></i>
                                <h2 class="mt-3">Acceso Denegado</h2>
                                <p class="text-muted">No tiene los permisos necesarios para ver esta sección.</p>
                                <a href="/" class="uta-btn uta-btn--primary mt-3">Volver al Inicio</a>
                            </div>
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
