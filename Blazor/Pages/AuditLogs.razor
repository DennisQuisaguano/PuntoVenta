@page "/admin/auditoria"
@using Application.Features.AuditLogs
@using Application.Common
@using Blazor.Services
@using Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@implements IDisposable
@attribute [Authorize(Roles = "Administrador")]
@inject AuditLogApiService ApiService
@inject NavigationManager NavManager
@inject IJSRuntime JS

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<div class="uta-page">
    <div class="uta-page-header">
        <div class="uta-page-header__left">
            <div class="uta-breadcrumb">
                <span style="cursor:pointer" @onclick='() => NavManager.NavigateTo("/")'>Panel Principal</span>
                <span class="uta-breadcrumb__sep">›</span>
                <span class="uta-breadcrumb__active">Auditoría General</span>
            </div>
            <h1 class="uta-page-title">
                <i class="bi bi-shield-lock-fill text-primary uta-page-title__icon"></i>
                Registro de Auditoría
            </h1>
            <p class="uta-page-subtitle">Trazabilidad completa de cambios en la base de datos (ChangeTracker)</p>
        </div>
    </div>

    <div class="uta-card">
        <div class="uta-card__header">
            <div class="uta-card__header-left">
                <i class="bi bi-search uta-card__header-icon"></i>
                Buscador de Historial
            </div>
        </div>
        <div class="uta-card__body">
            <div class="uta-search-bar mb-4" style="max-width: 800px; margin: 0 auto;">
                <select class="uta-search-bar__select" @bind="SearchCriterion">
                    <option value="all">Todos</option>
                    <option value="table">Tabla / Entidad</option>
                    <option value="user">Usuario</option>
                    <option value="action">Acción</option>
                    <option value="id">ID Afectado</option>
                </select>
                <input class="uta-search-bar__input" 
                       type="text" 
                       value="@SearchTerm" 
                       @oninput="OnInputSearch"
                       placeholder="Buscar en el registro de auditoría..." />
                <button class="uta-btn uta-btn--primary uta-search-bar__btn" @onclick="() => FetchLogs(1)">
                    <i class="bi bi-search"></i>
                </button>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
                <h6 class="m-0" style="font-size: 0.85rem; font-weight: 700; color: #495057; text-transform: uppercase; letter-spacing: 0.5px;">
                    <i class="bi bi-list-ul me-2"></i>Historial de Cambios
                </h6>
                <span class="uta-badge uta-badge--blue">@(_pagedResponse?.Items?.Count ?? 0) de @TotalItems mostrados</span>
            </div>

            <div class="uta-table-wrap uta-table-wrap--bordered">
                <table class="uta-table">
                    <thead>
                        <tr>
                            <th style="width: 180px;">Fecha y Hora</th>
                            <th>Usuario</th>
                            <th style="text-align:center">Acción</th>
                            <th>Tabla / Entidad</th>
                            <th>ID Afectado</th>
                            <th style="width: 100px; text-align:center;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_pagedResponse?.Items == null || !_pagedResponse.Items.Any())
                        {
                            <tr>
                                <td colspan="6" class="uta-table__empty">
                                    <div class="uta-empty-state">
                                        <div class="uta-empty-state__icon"><i class="bi bi-shield-check text-success"></i></div>
                                        <div class="uta-empty-state__text">No se encontraron registros de auditoría</div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in _pagedResponse.Items)
                            {
                                <tr>
                                    <td class="text-muted" style="font-size: 0.85rem;">@log.DateTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td>
                                        <span class="uta-badge uta-badge--blue">
                                            <i class="bi bi-person me-1"></i> @log.UserId
                                        </span>
                                    </td>
                                    <td style="text-align:center">
                                        <span class="uta-badge @(GetBadgeClass(log.Type))">@log.Type</span>
                                    </td>
                                    <td class="uta-table__bold">@log.TableName</td>
                                    <td><span class="uta-code-badge">@FormatPrimaryKey(log.PrimaryKey)</span></td>
                                    <td style="text-align:center;">
                                        <button class="uta-btn uta-btn--sm uta-btn--outline" @onclick="() => ShowDetail(log)">
                                            <i class="bi bi-eye"></i> Detalle
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (TotalItems > 0)
            {
                <div class="uta-pagination-footer rounded-bottom mt-3">
                    <div class="uta-pagination-info">
                        <span class="small text-muted">
                            Se muestran <strong class="uta-text-highlight">@From</strong> a <strong class="uta-text-highlight">@To</strong> de <strong class="uta-text-highlight">@TotalItems</strong> resultados
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">por página</span>
                        <div class="uta-select-wrapper">
                            <select class="form-select form-select-sm shadow-none" @onchange="OnPageSizeChanged">
                                @foreach (var size in new[] { 15, 25, 50, 100 })
                                {
                                    <option value="@size" selected="@(_pageSize == size)">@size</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="d-flex overflow-hidden">
                        @foreach (var p in VisiblePages)
                        {
                            if (p == -1)
                            {
                                <span class="uta-pagination-btn uta-pagination-btn--ellipsis">...</span>
                            }
                            else
                            {
                                var pNum = p;
                                <button class="uta-pagination-btn @(pNum == _currentPage ? "uta-pagination-btn--active" : "")"
                                        @onclick="() => ChangePage(pNum)">@pNum</button>
                            }
                        }
                        <button class="uta-pagination-btn @(!HasNext ? "disabled" : "")"
                                @onclick="NextPage"
                                disabled="@(!HasNext)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (_selectedLog != null)
{
    <div class="uta-overlay" @onclick="CloseModal">
        <div class="uta-modal uta-modal--xl" @onclick:stopPropagation="true">
            <div class="uta-modal__header">
                <div>
                    <h3 class="uta-modal__title">
                        <i class="bi bi-clock-history"></i> &nbsp;Detalle de Auditoría #@_selectedLog.Id
                    </h3>
                    <p class="uta-modal__subtitle">Diferencia de valores detectada por el ChangeTracker</p>
                </div>
                <button class="uta-modal__close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="uta-modal__body bg-light">
                <div class="uta-client-data-grid mb-4">
                    <div class="uta-data-item">
                        <span class="uta-data-item__label">Entidad / Tabla</span>
                        <span class="uta-data-item__value fw-bold">@_selectedLog.TableName</span>
                    </div>
                    <div class="uta-data-item">
                        <span class="uta-data-item__label">Operación</span>
                        <span class="uta-data-item__value">
                            <span class="uta-badge @(GetBadgeClass(_selectedLog.Type))">@_selectedLog.Type</span>
                        </span>
                    </div>
                    <div class="uta-data-item">
                        <span class="uta-data-item__label">Usuario</span>
                        <span class="uta-data-item__value">
                            <span class="uta-badge uta-badge--blue">
                                <i class="bi bi-person me-1"></i> @_selectedLog.UserId
                            </span>
                        </span>
                    </div>
                    <div class="uta-data-item uta-data-item--full">
                        <span class="uta-data-item__label">Fecha y Hora de Cambio</span>
                        <span class="uta-data-item__value">@_selectedLog.DateTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                    </div>
                </div>

                <div class="uta-diff-grid @(_selectedLog.Type != "Update" ? "uta-diff-grid--full" : "")">
                    @if (_selectedLog.Type == "Update")
                    {
                        <div style="grid-column: 1 / -1;">
                            <div class="uta-badge uta-badge--blue w-100 py-2 justify-content-center">
                                <i class="bi bi-pencil-square me-2"></i> Columnas afectadas: @FormatAffectedColumns(_selectedLog.AffectedColumns)
                            </div>
                        </div>
                        <div>
                            <div class="card h-100 border-danger shadow-sm">
                                <div class="card-header bg-danger text-white fw-bold">
                                    <i class="bi bi-arrow-left-circle me-2"></i> VALOR ANTERIOR
                                </div>
                                <div class="card-body p-0">
                                    <pre class="m-0 p-3 bg-white text-danger small" style="max-height: 400px; overflow: auto;">@FormatJson(_selectedLog.OldValues)</pre>
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="card h-100 border-success shadow-sm">
                                <div class="card-header bg-success text-white fw-bold">
                                    <i class="bi bi-arrow-right-circle me-2"></i> VALOR NUEVO
                                </div>
                                <div class="card-body p-0">
                                    <pre class="m-0 p-3 bg-white text-success small" style="max-height: 400px; overflow: auto;">@FormatJson(_selectedLog.NewValues)</pre>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_selectedLog.Type == "Create")
                    {
                        <div>
                            <div class="card border-success shadow-sm">
                                <div class="card-header bg-success text-white fw-bold">
                                    <i class="bi bi-plus-circle me-2"></i> REGISTRO CREADO
                                </div>
                                <div class="card-body p-0">
                                    <pre class="m-0 p-3 bg-white text-success small">@FormatJson(_selectedLog.NewValues)</pre>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div>
                            <div class="card border-danger shadow-sm">
                                <div class="card-header bg-danger text-white fw-bold">
                                    <i class="bi bi-trash me-2"></i> REGISTRO ELIMINADO
                                </div>
                                <div class="card-body p-0">
                                    <pre class="m-0 p-3 bg-white text-danger small">@FormatJson(_selectedLog.OldValues)</pre>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="uta-modal__footer">
                <button class="uta-btn uta-btn--outline w-100" @onclick="CloseModal">Cerrar Detalle</button>
            </div>
        </div>
    </div>
}

@code {
    private PagedResponse<AuditLogResponseDto>? _pagedResponse;
    private string SearchTerm = "";
    private int _currentPage = 1;
    private int _pageSize = 15;
    private AuditLogResponseDto? _selectedLog;
    private System.Timers.Timer? _debounceTimer;

    private int TotalItems => _pagedResponse?.TotalCount ?? 0;
    private int TotalPages => _pagedResponse?.TotalPages ?? 0;
    private bool HasNext => _pagedResponse?.HasNextPage ?? false;
    private List<int> VisiblePages => PaginationHelper.GenerateVisiblePages(_currentPage, TotalPages);

    private int From => TotalItems == 0 ? 0 : ((_currentPage - 1) * _pageSize) + 1;
    private int To => Math.Min(_currentPage * _pageSize, TotalItems);

    private string _searchCriterion = "all";
    private string SearchCriterion
    {
        get => _searchCriterion;
        set
        {
            if (_searchCriterion != value)
            {
                _searchCriterion = value;
                SearchTerm = string.Empty;
                _currentPage = 1;
                _ = FetchLogs(1);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _debounceTimer = new System.Timers.Timer(300);
        _debounceTimer.Elapsed += async (s, e) => await InvokeAsync(OnDebounceSearch);
        _debounceTimer.AutoReset = false;

        await FetchLogs(1);
    }

    private void OnInputSearch(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
        _debounceTimer?.Stop();
        _debounceTimer?.Start();
    }

    private async Task OnDebounceSearch()
    {
        await FetchLogs(1);
    }

    private async Task FetchLogs(int pageNumber)
    {
        _currentPage = pageNumber;
        _pagedResponse = await ApiService.GetPagedLogsAsync(_currentPage, _pageSize, SearchTerm, SearchCriterion);
        StateHasChanged();
    }

    private void ShowDetail(AuditLogResponseDto log) => _selectedLog = log;
    private void CloseModal() => _selectedLog = null;

    private async Task ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= TotalPages)
        {
            await FetchLogs(newPage);
        }
    }

    private async Task NextPage() => await ChangePage(_currentPage + 1);

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            _pageSize = newSize;
            _currentPage = 1;
            await FetchLogs(1);
        }
    }

    private string GetBadgeClass(string type) => type switch
    {
        "Create" => "uta-badge--green",
        "Update" => "uta-badge--blue",
        "Delete" => "uta-badge--red",
        _ => "uta-badge--light"
    };

    private string FormatPrimaryKey(string pkJson)
    {
        try 
        {
            var dict = JsonSerializer.Deserialize<Dictionary<string, object>>(pkJson);
            if (dict != null && dict.Count > 0)
            {
                return string.Join(", ", dict.Values);
            }
        }
        catch {}
        return pkJson;
    }

    private string FormatJson(string? json)
    {
        if (string.IsNullOrEmpty(json)) return "N/A";
        try
        {
            var options = new JsonSerializerOptions { WriteIndented = true };
            var element = JsonSerializer.Deserialize<JsonElement>(json);
            return JsonSerializer.Serialize(element, options);
        }
        catch { return json; }
    }

    private string FormatAffectedColumns(string? json)
    {
        if (string.IsNullOrEmpty(json)) return "Múltiples";
        try
        {
            var list = JsonSerializer.Deserialize<List<string>>(json);
            if (list != null && list.Count > 0)
            {
                return string.Join(", ", list);
            }
        }
        catch {}
        return json;
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}
