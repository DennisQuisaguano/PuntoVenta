@page "/forgot-password"
@layout Blazor.Layout.LoginLayout
@using Application.Features.Users
@using Blazor.Services
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject AuthApiService AuthApiService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Recuperar Contraseña - PuntoVenta</PageTitle>

<div class="uta-bg-wrapper">
    <div class="uta-login-container">
        <div class="uta-login-card">
            <div class="uta-login-header">
                <div class="uta-login-logo">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h2 class="uta-login-title">Recuperar Acceso</h2>
                <p class="uta-login-subtitle">Enviaremos un enlace a su correo electrónico</p>
            </div>

            @if (_isSent)
            {
                <div class="alert alert-success py-3 text-center" style="border-radius: 12px;">
                    <i class="bi bi-check-circle-fill d-block mb-2" style="font-size: 2rem;"></i>
                    <p class="m-0">Hemos enviado las instrucciones a su correo electrónico si está registrado.</p>
                </div>
                <button class="uta-login-btn w-100 mt-3" @onclick='() => Navigation.NavigateTo("/login")'>
                    Volver al Inicio
                </button>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger py-2 mb-3" style="font-size: 0.85rem; border-radius: 8px;">
                        <i class="bi bi-exclamation-circle-fill me-2"></i> @_errorMessage
                    </div>
                }

                <EditForm Model="_request" OnValidSubmit="HandleSubmit" class="uta-login-form">
                    <DataAnnotationsValidator />
                    
                    <div class="uta-form-group">
                        <label class="uta-form-label">Correo Electrónico</label>
                        <div class="uta-input-wrapper">
                            <i class="bi bi-envelope uta-input-icon"></i>
                            <input type="email" class="uta-form-control" placeholder="ejemplo@empresa.com" @bind="_request.Email" required />
                        </div>
                    </div>

                    <button type="submit" class="uta-login-btn" disabled="@_isProcessing">
                        @if (_isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <span>Enviar Enlace de Recuperación</span>
                        }
                    </button>

                    <div class="text-center mt-4">
                        <a href="/login" class="uta-forgot-password" style="font-size: 0.9rem;">
                            <i class="bi bi-arrow-left"></i> Volver al Login
                        </a>
                    </div>
                </EditForm>
            }

            <div class="uta-login-footer">
                <p>&copy; @DateTime.Now.Year Sistema UTA POS. Todos los derechos reservados.</p>
            </div>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordRequest _request = new();
    private bool _isProcessing = false;
    private bool _isSent = false;
    private string? _errorMessage;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_request.Email)) return;

        _isProcessing = true;
        _errorMessage = null;

        var result = await AuthApiService.ForgotPasswordAsync(_request);

        if (result.IsSuccess)
        {
            _isSent = true;
        }
        else
        {
            _errorMessage = result.Message;
        }

        _isProcessing = false;
    }
}
