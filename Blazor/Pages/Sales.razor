    }

    private async Task RemoveOutOfStockAndContinue()
    {
        _showStockErrorModal = false;
        
        foreach (var error in _outOfStockProducts)
        {
            var item = _cart.FirstOrDefault(c => c.ProductId == error.ProductId);
            if (item != null)
            {
                _cart.Remove(item);
            }
        }
        
        RecalculateInvoiceTotals();
        
        if (_cart.Any())
        {
            await ShowNotification("Productos sin stock eliminados. Puede agregar nuevos productos o intentar confirmar.");
        }
        else
        {
            await ShowNotification("La factura quedó vacía tras eliminar los productos sin stock.", true);
        }
    }

