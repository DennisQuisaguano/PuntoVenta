    private void HandleShortcuts(string key)
    {
        InvokeAsync(async () => {
            if (key == "Escape") 
            {
                CloseCustomerModal();
                CloseProductModal();
                _showDraftsModal = false;
            }
            else if (!_showCustomerModal && !_showProductModal && !_showDraftsModal)
            {
                if (key == "F2") await OpenCustomerModal();
                if (key == "F4") await OpenProductModal();
                if (key == "F8" && CanFinalize && !_isProcessingSale && !_saleCompleted) await SellAndConfirm();
                if (key == "F9" && CanFinalize && !_isProcessingSale && !_saleCompleted) await SaveAsDraft();
                if (key == "F10" && !_isProcessingSale && !_saleCompleted) await CancelForm();
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Shortcuts.OnShortcutPressed -= HandleShortcuts;
        _debounceTimer?.Dispose();
    }
}