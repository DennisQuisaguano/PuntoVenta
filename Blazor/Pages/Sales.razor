@if (_showDraftsModal)
{
    <div class="uta-overlay" @onclick="CloseDraftsModal">
        <div class="uta-modal uta-modal--lg" @onclick:stopPropagation="true">
            <div class="uta-modal__header">
                <div>
                    <h3 class="uta-modal__title"><i class="bi bi-folder2-open"></i> &nbsp;Recuperar Borrador</h3>
                    <p class="uta-modal__subtitle">Seleccione un borrador guardado para continuar editando</p>
                </div>
                <button class="uta-modal__close" @onclick="CloseDraftsModal"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="uta-modal__body">
                <div class="uta-table-wrap uta-table-wrap--bordered">
                    <table class="uta-table">
                        <thead>
                            <tr>
                                <th>Número</th>
                                <th>Cliente</th>
                                <th>Fecha</th>
                                <th style="text-align:right">Total</th>
                                <th style="text-align:center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_isLoadingDrafts)
                            {
                                <tr>
                                    <td colspan="5" class="uta-table__empty">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else if (!_draftResults.Any())
                            {
                                <tr>
                                    <td colspan="5" class="uta-table__empty">
                                        <div class="uta-empty-state">
                                            <div class="uta-empty-state__icon"><i class="bi bi-folder-x"></i></div>
                                            <div class="uta-empty-state__text">No hay borradores pendientes</div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var draft in _draftResults)
                                {
                                    <tr @key="draft.Id">
                                        <td><span class="uta-code-badge">@draft.InvoiceNumber</span></td>
                                        <td class="uta-table__bold">@draft.CustomerName</td>
                                        <td>@(DateTime.TryParse(draft.IssueDate, out var date) ? date.ToString("dd/MM/yyyy HH:mm") : draft.IssueDate)</td>
                                        <td style="text-align:right">
                                            <div class="uta-price uta-price--right">
                                                <span class="uta-price__symbol">$</span>
                                                <span class="uta-price__value">@draft.Total.ToString("N2")</span>
                                            </div>
                                        </td>
                                        <td style="text-align:center">
                                            <button class="uta-btn uta-btn--sm uta-btn--primary" @onclick="() => LoadDraft(draft)">
                                                <i class="bi bi-arrow-down-square"></i> Recuperar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (_totalDraftPages > 1)
            {
                <div class="uta-pagination-footer rounded-bottom">
                    <div class="d-flex overflow-hidden">
                        <button class="uta-pagination-btn @(_currentDraftPage == 1 ? "disabled" : "")"
                                @onclick="() => LoadDraftsPage(_currentDraftPage - 1)"
                                disabled="@(_currentDraftPage == 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <span class="uta-pagination-btn uta-pagination-btn--active">@_currentDraftPage</span>
                        <button class="uta-pagination-btn @(_currentDraftPage >= _totalDraftPages ? "disabled" : "")"
                                @onclick="() => LoadDraftsPage(_currentDraftPage + 1)"
                                disabled="@(_currentDraftPage >= _totalDraftPages)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (_showStockErrorModal)
{
    <div class="uta-overlay" @onclick="CloseStockErrorModal">
        <div class="uta-modal uta-modal--md" style="max-width: 600px; width: 100%; margin: 0 auto;" @onclick:stopPropagation="true">
            <div class="uta-modal__header" style="background-color: #6B1A33;">
                <div>
                    <h3 class="uta-modal__title"><i class="bi bi-exclamation-circle"></i> &nbsp;Atención: Stock Insuficiente</h3>
