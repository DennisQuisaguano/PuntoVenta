    private Dictionary<string, string> _newCustomerErrors = new();

    private bool HasNewCustomerError(string field) => _newCustomerErrors.ContainsKey(field);
    private string GetNewCustomerError(string field) => _newCustomerErrors.TryGetValue(field, out var error) ? error : "";

    private void ValidateNewCustomerField(string field, string val, string label)
    {
        _newCustomerErrors.Remove(field);
        
        if (string.IsNullOrWhiteSpace(val))
        {
            _newCustomerErrors[field] = $"{label} es requerido.";
            return;
        }

        if (field == "IDCard")
        {
            if (val.Length != 10)
            {
                _newCustomerErrors[field] = "La cédula debe tener exactamente 10 dígitos.";
            }
            return;
        }

        if (field == "Phone")
        {
            if (val.Length != 10)
            {
                _newCustomerErrors[field] = "El teléfono debe tener exactamente 10 dígitos.";
            }
            else if (!val.StartsWith("09"))
            {
                _newCustomerErrors[field] = "El teléfono debe empezar con '09'.";
            }
            return;
        }

        if (field == "Email" && !IsValidEmail(val))
        {
            _newCustomerErrors[field] = "Formato de correo no válido.";
            return;
        }

        if ((field == "Name" || field == "LastName") && !System.Text.RegularExpressions.Regex.IsMatch(val, @"^[a-zA-ZáéíóúÁÉÍÓÚñÑ]+$"))
        {
            _newCustomerErrors[field] = $"{label} solo debe contener letras.";
            return;
        }

        if ((field == "Name" || field == "LastName") && val.Length < 2)
        {
            _newCustomerErrors[field] = $"{label} debe tener al menos 2 letras.";
            return;
        }
    }

    private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address.Equals(email, StringComparison.OrdinalIgnoreCase);
        }
        catch { return false; }
    }

