    private async Task UpdateQuantity(CartItemModel item, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int newQuantity))
        {
            item.Amount = 1;
            await ShowNotification("Entrada no válida.", true);
        }
        else
        {
            if (newQuantity > item.AvailableStock)
            {
                item.Amount = 1;
                await ShowNotification($"Cantidad insuficiente. Solo hay {item.AvailableStock} disponibles.", true);
            }
            else
            {
                item.Amount = newQuantity < 1 ? 1 : newQuantity;
            }
        }

        RecalculateInvoiceTotals();
        StateHasChanged();
    }

    private void RecalculateInvoiceTotals()
    {
        _salesModel.Subtotal = _cart.Sum(x => x.SubTotal);
        _salesModel.Vat = _salesModel.Subtotal * VatRateMultiplier;
        _salesModel.Total = _salesModel.Subtotal + _salesModel.Vat;
    
        StateHasChanged(); 
    }

