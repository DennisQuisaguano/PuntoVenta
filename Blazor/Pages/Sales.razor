    private async Task<bool> Confirmed(object result)
    {
        if (result == null) return false;

        try
        {
            var element = (JsonElement)result;
            return element.TryGetProperty("isConfirmed", out var confirmed) && confirmed.GetBoolean();
        }
        catch
        {
            return false;
        }
    }

