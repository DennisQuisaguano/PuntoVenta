    private async Task SaveNewCustomerAsync()
    {
        ValidateNewCustomerField("IDCard", _newCustomer.IDCard, "Cédula");
        ValidateNewCustomerField("Phone", _newCustomer.Phone, "Teléfono");
        ValidateNewCustomerField("Name", _newCustomer.Name, "Nombre");
        ValidateNewCustomerField("LastName", _newCustomer.LastName, "Apellido");
        ValidateNewCustomerField("Email", _newCustomer.Email, "Correo");
        
        if (_newCustomerErrors.Any())
        {
            await JS.InvokeVoidAsync("Swal.fire", "Formulario Inválido", "Por favor corrija los errores en el formulario.", "warning");
            return;
        }

        _isSavingCustomer = true;
        StateHasChanged();

        try
        {
            var response = await CustomerApiService.CreateCustomerAsync(_newCustomer);
            if (response.IsSuccessStatusCode)
            {
                await ShowNotification("Cliente creado y seleccionado correctamente.");
                
                // Set values to select it
                _customerTerm = _newCustomer.IDCard;
                CustomerSearchCriterion = "card";
                _isCreatingCustomer = false;
                
                // Load clients and automatically select it if found
                await LoadClientsAsync();
                
                var createdCustomer = PagedCustomers.FirstOrDefault(c => c.IDCard == _newCustomer.IDCard);
                if (createdCustomer != null)
                {
                    await SelectCustomer(createdCustomer);
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("Swal.fire", "Error al crear", "No se pudo registrar el cliente. Posiblemente ya exista. " + error, "error");
            }
        }
        catch (Exception ex)
        {
            await ShowNotification("Error de comunicación.", true);
        }
        finally
        {
            _isSavingCustomer = false;
            StateHasChanged();
        }
    }

