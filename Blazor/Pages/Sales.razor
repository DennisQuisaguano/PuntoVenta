    private async Task<bool> ConfirmDraft()
    {
        _isProcessingSale = true;
        StateHasChanged();
        bool success = false;

        var response = await ApiService.ConfirmSaleAsync(_createdSaleId);
        if (response.IsSuccessStatusCode)
        {
            _saleStatus = Domain.Enums.SaleStatus.Confirmed;
            await ShowNotification("¡Venta confirmada y stock actualizado!");
            success = true;
        }
        else
        {
            var errorJson = await response.Content.ReadAsStringAsync();
            try {
                using var doc = JsonDocument.Parse(errorJson);
                var root = doc.RootElement;
                if (root.TryGetProperty("type", out var typeProp) && typeProp.GetString() == "BulkStock")
                {
                    var errorsProp = root.GetProperty("errors");
                    _outOfStockProducts = JsonSerializer.Deserialize<List<StockValidationErrorModel>>(errorsProp.GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                    _showStockErrorModal = true;
                }
                else 
                {
                    await JS.InvokeVoidAsync("Swal.fire", "Error de Stock", "No se pudo confirmar: " + errorJson, "warning");
                }
            } catch {
                await JS.InvokeVoidAsync("Swal.fire", "Error de Stock", "No se pudo confirmar: " + errorJson, "warning");
            }
        }

        _isProcessingSale = false;
        StateHasChanged();
        return success;
    }

    private bool _showStockErrorModal = false;
    private List<StockValidationErrorModel> _outOfStockProducts = new();

    private void CloseStockErrorModal()
    {
