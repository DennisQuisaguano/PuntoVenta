@page "/reset-password"
@layout Blazor.Layout.LoginLayout
@using Application.Features.Users
@using Blazor.Services
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject AuthApiService AuthApiService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Establecer Nueva Contraseña - PuntoVenta</PageTitle>

<div class="uta-bg-wrapper">
    <div class="uta-login-container">
        <div class="uta-login-card">
            <div class="uta-login-header">
                <div class="uta-login-logo">
                    <i class="bi bi-key-fill"></i>
                </div>
                <h2 class="uta-login-title">Nueva Contraseña</h2>
                <p class="uta-login-subtitle">Ingrese sus nuevas credenciales de acceso</p>
            </div>

            @if (_isSuccess)
            {
                <div class="alert alert-success py-3 text-center" style="border-radius: 12px;">
                    <i class="bi bi-shield-check d-block mb-2" style="font-size: 2rem;"></i>
                    <p class="m-0">Su contraseña ha sido restablecida con éxito.</p>
                </div>
                <button class="uta-login-btn w-100 mt-3" @onclick='() => Navigation.NavigateTo("/login")'>
                    Ir al Inicio de Sesión
                </button>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger py-2 mb-3" style="font-size: 0.85rem; border-radius: 8px;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_errorMessage
                    </div>
                }

                <EditForm Model="_request" OnValidSubmit="HandleSubmit" class="uta-login-form">
                    <DataAnnotationsValidator />
                    
                    <div class="uta-form-group">
                        <label class="uta-form-label">Nueva Contraseña</label>
                        <div class="uta-input-wrapper">
                            <i class="bi bi-lock uta-input-icon"></i>
                            <input type="@(_showPassword ? "text" : "password")" class="uta-form-control" placeholder="••••••••" @bind="_request.NewPassword" required maxlength="10" />
                            <button type="button" class="btn text-muted position-absolute end-0 top-50 translate-middle-y border-0 bg-transparent pe-3" @onclick="TogglePasswordVisibility">
                                <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                    </div>

                    <div class="uta-form-group">
                        <label class="uta-form-label">Confirmar Contraseña</label>
                        <div class="uta-input-wrapper">
                            <i class="bi bi-lock-fill uta-input-icon"></i>
                            <input type="@(_showPassword ? "text" : "password")" class="uta-form-control" placeholder="••••••••" @bind="_request.ConfirmPassword" required maxlength="10" />
                        </div>
                    </div>

                    <button type="submit" class="uta-login-btn" disabled="@_isProcessing">
                        @if (_isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Establecer Contraseña</span>
                        }
                    </button>
                </EditForm>
            }

            <div class="uta-login-footer">
                <p>&copy; @DateTime.Now.Year Sistema UTA POS. Todos los derechos reservados.</p>
            </div>
        </div>
    </div>
</div>

@code {
    private ResetPasswordRequest _request = new();
    private bool _isProcessing = false;
    private bool _isSuccess = false;
    private bool _showPassword = false;
    private string? _errorMessage;

    [SupplyParameterFromQuery] public string? token { get; set; }
    [SupplyParameterFromQuery] public string? email { get; set; }

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(token) || string.IsNullOrEmpty(email))
        {
            _errorMessage = "El enlace de recuperación es inválido o está incompleto.";
        }
        else
        {
            _request.Token = token;
            _request.Email = email;
        }
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrEmpty(_request.Token) || string.IsNullOrEmpty(_request.Email))
        {
            _errorMessage = "Datos de recuperación faltantes.";
            return;
        }

        if (_request.NewPassword != _request.ConfirmPassword)
        {
            _errorMessage = "Las contraseñas no coinciden.";
            return;
        }

        if (_request.NewPassword.Length < 8)
        {
             _errorMessage = "La contraseña debe tener al menos 8 caracteres.";
             return;
        }

        _isProcessing = true;
        _errorMessage = null;

        var result = await AuthApiService.ResetPasswordAsync(_request);

        if (result.IsSuccess)
        {
            _isSuccess = true;
            await JS.InvokeVoidAsync("Swal.fire", "¡Éxito!", "Contraseña restablecida correctamente.", "success");
        }
        else
        {
            _errorMessage = result.Message;
        }

        _isProcessing = false;
    }
}
