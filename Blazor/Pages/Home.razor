@page "/"
@using System.Globalization
@using Application.Features.Users
@using Blazor.Services
@inject NavigationManager NavManager
@inject UserApiService UserApiService
@attribute [Authorize]

<PageTitle>Panel de Control - MI NEGOCIO</PageTitle>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

<div class="uta-page">
    <div class="uta-page-header">
        <div class="uta-page-header__left">
            <h1 class="uta-page-title" style="font-size: 2rem;">
                <i class="bi bi-hand-wave-fill text-warning"></i> ¡Bienvenido!
            </h1>
            <p class="uta-page-subtitle" style="font-size: 1rem; margin-top: 0.3rem;">
                Resumen de tu jornada: <strong style="text-transform: capitalize;">@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new CultureInfo("es-ES"))</strong>
            </p>
        </div>
        <div class="uta-page-header__right">
            <AuthorizeView Roles="Vendedor">
                <button class="uta-btn uta-btn--primary uta-btn--lg" @onclick='() => NavManager.NavigateTo("/ventas")'>
                    <i class="bi bi-cart-plus"></i> &nbsp;Iniciar Nueva Venta
                </button>
            </AuthorizeView>
        </div>
    </div>

    <div class="uta-dashboard-grid">
        @if (_stats.IsAdmin)
        {
            <!-- KPIs ADMINISTRADOR -->
            <div class="uta-kpi-card" @onclick='() => NavManager.NavigateTo("/facturas")' style="cursor:pointer">
                <div class="uta-kpi-card__icon" style="background-color: #fdf5f7; color: #6B1A33;">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="uta-kpi-card__info">
                    <span class="uta-kpi-card__label">Recaudación Hoy</span>
                    <span class="uta-kpi-card__value">$@_stats.SystemDailyRevenue.ToString("N2")</span>
                </div>
            </div>

            <div class="uta-kpi-card">
                <div class="uta-kpi-card__icon" style="background-color: #f0fdf4; color: #16a34a;">
                    <i class="bi bi-receipt"></i>
                </div>
                <div class="uta-kpi-card__info">
                    <span class="uta-kpi-card__label">Facturas Hoy</span>
                    <span class="uta-kpi-card__value">@_stats.SystemDailySalesCount</span>
                </div>
            </div>

            <div class="uta-kpi-card" @onclick='() => NavManager.NavigateTo("/productos")' style="cursor:pointer">
                <div class="uta-kpi-card__icon" style="background-color: #fff1f2; color: #e11d48;">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div class="uta-kpi-card__info">
                    <span class="uta-kpi-card__label">Stock Crítico</span>
                    <span class="uta-kpi-card__value">@_stats.SystemLowStockCount</span>
                </div>
            </div>

            <div class="uta-kpi-card">
                <div class="uta-kpi-card__icon" style="background-color: #fdf4ff; color: #c026d3;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="uta-kpi-card__info">
                    <span class="uta-kpi-card__label">Clientes Activos</span>
                    <span class="uta-kpi-card__value">@_stats.SystemTotalCustomersCount</span>
                </div>
            </div>
        }
        else
        {
            <!-- KPIs VENDEDOR -->
            <div class="uta-kpi-card">
                <div class="uta-kpi-card__icon" style="background-color: #fdf5f7; color: #6B1A33;">
                    <i class="bi bi-cash-coin"></i>
                </div>
                <div class="uta-kpi-card__info">
                    <span class="uta-kpi-card__label">Mis Ventas Hoy</span>
                    <span class="uta-kpi-card__value">$@_stats.MyDailySalesAmount.ToString("N2")</span>
                </div>
            </div>

            <div class="uta-kpi-card">
                <div class="uta-kpi-card__icon" style="background-color: #f0fdf4; color: #16a34a;">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <div class="uta-kpi-card__info">
                    <span class="uta-kpi-card__label">Mis Facturas Hoy</span>
                    <span class="uta-kpi-card__value">@_stats.MyDailySalesCount</span>
                </div>
            </div>

            <div class="uta-kpi-card">
                <div class="uta-kpi-card__icon" style="background-color: #eff6ff; color: #2563eb;">
                    <i class="bi bi-calculator"></i>
                </div>
                <div class="uta-kpi-card__info">
                    <span class="uta-kpi-card__label">Ticket Promedio</span>
                    <span class="uta-kpi-card__value">$@_stats.MyAverageTicket.ToString("N2")</span>
                </div>
            </div>

            <div class="uta-kpi-card">
                <div class="uta-kpi-card__icon" style="background-color: #fefce8; color: #ca8a04;">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div class="uta-kpi-card__info">
                    <span class="uta-kpi-card__label">Items Catálogo</span>
                    <span class="uta-kpi-card__value">@_stats.SystemTotalProductsCount</span>
                </div>
            </div>
        }
    </div>

    <div class="uta-card mt-4">
        <div class="uta-card__header">
            <span class="uta-card__header-icon"><i class="bi bi-lightning-charge-fill text-warning"></i></span> 
            Accesos Rápidos
        </div>
        <div class="uta-card__body">
            <div class="uta-quick-actions">
                <AuthorizeView Roles="Vendedor">
                    <button class="uta-action-box" @onclick='() => NavManager.NavigateTo("/ventas")'>
                        <div class="uta-action-box__icon"><i class="bi bi-cart3"></i></div>
                        <div class="uta-action-box__title">Punto de Venta</div>
                        <div class="uta-action-box__desc">Facturar productos a clientes</div>
                    </button>
                </AuthorizeView>

                <AuthorizeView Roles="Administrador">
                    <button class="uta-action-box" @onclick='() => NavManager.NavigateTo("/usuarios")'>
                        <div class="uta-action-box__icon"><i class="bi bi-person-gear"></i></div>
                        <div class="uta-action-box__title">Gestión de Personal</div>
                        <div class="uta-action-box__desc">Administrar usuarios y accesos</div>
                    </button>

                    <button class="uta-action-box" @onclick='() => NavManager.NavigateTo("/productos")'>
                        <div class="uta-action-box__icon"><i class="bi bi-box-seam"></i></div>
                        <div class="uta-action-box__title">Inventario</div>
                        <div class="uta-action-box__desc">Gestionar catálogo de productos</div>
                    </button>

                    <button class="uta-action-box" @onclick='() => NavManager.NavigateTo("/clientes")'>
                        <div class="uta-action-box__icon"><i class="bi bi-people"></i></div>
                        <div class="uta-action-box__title">Clientes</div>
                        <div class="uta-action-box__desc">Directorio de clientes registrados</div>
                    </button>
                </AuthorizeView>

                <button class="uta-action-box" @onclick='() => NavManager.NavigateTo("/facturas")'>
                    <div class="uta-action-box__icon"><i class="bi bi-journal-text"></i></div>
                    <div class="uta-action-box__title">Facturación</div>
                    <div class="uta-action-box__desc">Consultar historial de ventas</div>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private ProfileStatsDto _stats = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardStats();
    }

    private async Task LoadDashboardStats()
    {
        var stats = await UserApiService.GetProfileStatsAsync();
        if (stats != null)
        {
            _stats = stats;
        }
    }
}
